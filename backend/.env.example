# ─────────────────────────────────────────────────────────────────
# AgentSights Backend — Environment Variables
# Copy to .env for local dev, or set directly in Railway dashboard
# NEVER commit .env to git
# ─────────────────────────────────────────────────────────────────

# Your GitHub username (lowercase) — used by docker-compose.prod.yml to pull the image
GITHUB_USERNAME=your-github-username-lowercase

# Django Core
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-long-random-secret-key-here

# False in production, True only for local development
DEBUG=False

# Comma-separated hostnames (no http://, no trailing slash)
# Example: api.agentsights.com,agentsights-backend.up.railway.app
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins (include scheme)
# Example: https://agentsights.com,https://www.agentsights.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─────────────────────────────────────────────────────────────────
# Supabase PostgreSQL (Connection Pooling — Transaction Mode)
# Dashboard → Settings → Database → Connection Pooling
# ─────────────────────────────────────────────────────────────────
DB_NAME=postgres
DB_USER=postgres.your-supabase-project-ref
DB_PASSWORD=your-supabase-db-password
DB_HOST=aws-0-eu-west-1.pooler.supabase.com
DB_PORT=6543

# ─────────────────────────────────────────────────────────────────
# HuggingFace — required for pyannote speaker diarization
# https://huggingface.co/settings/tokens
# Accept the pyannote model license before use:
# https://huggingface.co/pyannote/speaker-diarization-3.1
# ─────────────────────────────────────────────────────────────────
HF_TOKEN=hf_your_token_here

# ─────────────────────────────────────────────────────────────────
# OpenAI — for GPT-4 call summarization
# https://platform.openai.com/api-keys
# ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-your-openai-key-here

# ─────────────────────────────────────────────────────────────────
# Ollama — local LLM for coaching tips (optional)
# If Ollama is unreachable, coaching tips fall back to rule-based logic
#
# ⚠️  IMPORTANT: the URL changes depending on where you run:
#   Local dev (no Docker):  http://localhost:11434/api/generate
#   Production (Droplet):   http://ollama:11434/api/generate   ← use this
# ─────────────────────────────────────────────────────────────────
OLLAMA_API_URL=http://ollama:11434/api/generate
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2

# Django log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
DJANGO_LOG_LEVEL=WARNING
